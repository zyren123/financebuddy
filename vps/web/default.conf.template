server {
    listen 80;
    root /usr/share/nginx/html;

    location = /api/td {
        proxy_pass http://td-cache:8787;
        proxy_set_header x-td-cache-token "${TD_CACHE_TOKEN}";
    }

    location = /api/layout {
        proxy_pass http://td-cache:8787;
        proxy_set_header x-td-cache-token "${TD_CACHE_TOKEN}";
        client_max_body_size 256k;
    }

    location /api/ {
        return 404;
    }

    location / {
        try_files $uri /index.html;
    }
}
